# ==============================================================================
# Alquimia LMS — Variables de Entorno (.env.example)
# Copia este archivo a .env.local y completa los valores correspondientes.
# NUNCA subas secretos reales al repositorio.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Auth SSR, Base de Datos Relacional y Realtime)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-solo-servidor

# ------------------------------------------------------------------------------
# 2. Puertos Locales & Cerebro Python Core (FastAPI / Pydantic / PyMuPDF)
# ------------------------------------------------------------------------------
PORT=3100
CEREBRO_PY_URL=http://127.0.0.1:8155
CEREBRO_PY_HOST=127.0.0.1
CEREBRO_PY_PORT=8155

# ------------------------------------------------------------------------------
# 3. Qdrant Vector DB — RAG Híbrido Científico (Preparado para Fases 1-2)
# ------------------------------------------------------------------------------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=tu-qdrant-api-key-aqui
QDRANT_COLLECTION=alquimia_ciencia

# ------------------------------------------------------------------------------
# 4. Autenticación Administrativa Autónoma y Seguridad M2M
# ------------------------------------------------------------------------------
ADMIN_EMAIL=director@agencialquimia.com
ADMIN_PASSWORD=tu-contrasena-maestra-aqui
ADMIN_JWT_SECRET=tu-jwt-secret-de-al-menos-32-caracteres
ALQUIMIA_BACKEND_API_KEY=tu-api-key-interna-aqui
SUPABASE_WEBHOOK_SECRET=tu-secreto-para-webhooks-supabase

# ------------------------------------------------------------------------------
# 5. [LEGACY / DEPRECADO — Retirada prevista en Fases 1-2] Integración n8n
# Se mantiene temporalmente en Fase 0 únicamente como fallback para baseline.
# ------------------------------------------------------------------------------
N8N_CEREBRO_URL=https://tu-n8n.ejemplo.com/webhook/cerebro
N8N_SECRET_TOKEN=tu-token-secreto-aqui
